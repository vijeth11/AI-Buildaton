APP_ENV=local
CLAIMS_DB_PATH=.local/claims.sqlite3
CLAIMS_API_BASE_URL=http://127.0.0.1:8000
AUTH_SIGNING_SECRET=
AUTH_TOKEN_LIFETIME_SECONDS=14400
RISK_SCORE_THRESHOLD=60
FRAUD_SCORE_THRESHOLD=40
AUTO_SETTLEMENT_AMOUNT_LIMIT=50000
USE_CHROMA=true
CHROMA_PATH=.chroma
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
GPT_EXPLANATIONS_ENABLED=true
LLM_AGENTS_ENABLED=true
OPENAI_MODEL=gpt-5
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
OPENAI_INPUT_COST_PER_1K_USD=
OPENAI_OUTPUT_COST_PER_1K_USD=
